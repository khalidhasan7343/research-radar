    given-names: "MD Khalid"
version: "1.0.0"
license: MIT
repository-code: "https://github.com/khalidhasan7343/research-radar"
keywords:
  - research trends
  - bibliometrics
  - topic modeling
references:
  - type: software
    title: "RTanalysis"
    authors:
      - family-names: "Mahmud"
        given-names: "Faysal"
    repository-code: "https://github.com/Faysal-star/RTanalysis"
    notes: "Research Radar is built on RTanalysis and uses ideas and some code from it with the author's permission."
